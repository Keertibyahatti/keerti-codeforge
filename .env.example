# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite default for quick start, or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://codeforge:codeforge123@localhost:5432/codeforge_db?schema=public"

# Authentication Security
JWT_SECRET="codeforge_ai_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"

# AI Provider Configuration (Google Gemini / OpenAI compatible)
# Optional: system will function for code execution even if AI_API_KEY is not set
AI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
