datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model User {
  id                  String                @id @default(uuid())
  name                String
  email               String                @unique
  passwordHash        String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  programs            Program[]
  projects            Project[]
  executions          Execution[]
  auditLogs           AuditLog[]
  interviewAttempts   InterviewSubmission[]
}

model Program {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  language    String
  code        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  versions    CodeVersion[]
  executions  Execution[]
}

model CodeVersion {
  id        String   @id @default(uuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  code      String
  language  String
  createdAt DateTime @default(now())
}

model Project {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?         @default("")
  language       String          @default("python")
  framework      String?         @default("cli")
  isPublic       Boolean         @default(false)
  readinessScore Int             @default(85)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  files          ProjectFile[]
  securityScans  SecurityScan[]
  testResults    TestResult[]
}

model ProjectFile {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String   // e.g. "src/main.py"
  name      String   // e.g. "main.py"
  isFolder  Boolean  @default(false)
  content   String   @default("")
  language  String   @default("python")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Execution {
  id            String       @id @default(uuid())
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  programId     String?
  program       Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  language      String
  code          String
  input         String?      @default("")
  status        String       // "success", "error", "timeout", "compilation_error"
  stdout        String?      @default("")
  stderr        String?      @default("")
  executionTime Int          // milliseconds
  exitCode      Int          @default(0)
  createdAt     DateTime     @default(now())
  aiAnalyses    AIAnalysis[]
}

model AIAnalysis {
  id                      String    @id @default(uuid())
  executionId             String
  execution               Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  errorType               String
  explanation             String
  possibleCause           String?   @default("")
  suggestedFix            String
  correctedCode           String
  optimizationSuggestions String?   @default("[]")
  createdAt               DateTime  @default(now())
}

model SecurityScan {
  id          String   @id @default(uuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vulnerability String
  severity    String   // "CRITICAL", "HIGH", "MEDIUM", "LOW"
  file        String
  line        Int
  explanation String
  suggestedFix String
  status      String   @default("OPEN") // "OPEN", "FIXED"
  createdAt   DateTime @default(now())
}

model TestResult {
  id        String   @id @default(uuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suiteName String
  testName  String
  status    String   // "PASSED", "FAILED", "SKIPPED"
  duration  Int
  errorMsg  String?  @default("")
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  createdAt DateTime @default(now())
}

model InterviewSubmission {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemTitle  String
  difficulty    String   // "Easy", "Medium", "Hard"
  code          String
  language      String
  score         Int      // 0 - 100
  feedback      String
  passed        Boolean  @default(true)
  createdAt     DateTime @default(now())
}
